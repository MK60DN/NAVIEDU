# ============================================================================
# Tender v2.0 — Embracing Heterogeneity
# Git 忽略规则
# ============================================================================

# ============================================================================
# Python 标准忽略规则
# ============================================================================

# --- 字节码与编译文件 ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- 构建产物 ---
build/
dist/
*.egg-info/
*.egg
.eggs/
parts/
bin/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# --- 环境与虚拟环境 ---
.env
.venv
venv/
env/
ENV/
env.bak/
venv.bak/
.venv.bak/

# --- IDE 与编辑器 ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.iml
.project
.pydevproject
.settings/

# --- 测试与覆盖率 ---
.coverage
coverage/
coverage.xml
htmlcov/
.pytest_cache/
.cache/
.hypothesis/
*.log
test-results/

# --- Jupyter Notebook ---
.ipynb_checkpoints/

# --- 类型检查 ---
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ============================================================================
# Tender 项目专属忽略规则
# ============================================================================

# --- 数据文件（不提交原始数据） ---
data/input/*
data/output/*
data/cache/*
data/raw/*
data/processed/*
# 保留目录结构
!data/input/.gitkeep
!data/output/.gitkeep
!data/cache/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
# 知识图谱模板
!data/knowledge_graph.yaml

# --- 日志文件 ---
logs/
*.log

# --- 模型权重（避免提交大文件） ---
models/
*.pt
*.pth
*.h5
*.keras
*.onnx
*.pb
*.tflite
*.ckpt
*.bin

# --- 本地配置文件（包含密钥等敏感信息） ---
config/local.yaml
config/production.yaml
config/*.secret.yaml
*.secret.yaml

# --- API 密钥文件 ---
.env
.env.local
*.key
keys/

# --- 可视化输出 ---
output/visualizations/*
output/reports/*
# 保留目录结构
!output/visualizations/.gitkeep
!output/reports/.gitkeep

# --- 临时文件 ---
tmp/
temp/
*.tmp
*.temp

# --- 操作系统文件 ---
Thumbs.db
Desktop.ini
*.bak
.cache/

# --- 大文件追踪（使用 Git LFS 的替代方案） ---
*.zarr
*.npy
*.npz

# ============================================================================
# 环境特定的日志
# ============================================================================
profiling/
benchmark/
wandb/
runs/

# ============================================================================
# Docker
# ============================================================================
.dockerignore
Dockerfile
docker-compose*.yml

# ============================================================================
# 文档生成
# ============================================================================
docs/_build/
docs/build/
site/

# ============================================================================
# Git LFS 追踪链接文件（如果使用 LFS）
# ============================================================================
*.gitattributes
