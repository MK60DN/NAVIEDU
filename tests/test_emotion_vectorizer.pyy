"""
情绪向量化模块单元测试

测试 NeuroSymbolicVectorizer 和 MultimodalVectorizer 的核心功能。
注意：需要配置有效的 api_url 和 api_key 才能运行 LLM 相关测试。
"""

import pytest
import numpy as np
from typing import Dict, List, Any

from tender.emotion_vectorizer.neuro_symbolic_vectorizer import (
    NeuroSymbolicVectorizer,
)
from tender.emotion_vectorizer.multimodal_vectorizer import (
    MultimodalVectorizer,
)


# ============================================================================
# 测试数据
# ============================================================================

SAMPLE_MESSAGES = [
    {"text": "今天的项目进展非常顺利，大家都辛苦了！", "timestamp": 1717200000.0},
    {"text": "太开心了，我们终于完成了这个里程碑！", "timestamp": 1717200060.0},
    {"text": "不过我觉得还有一些小问题需要改进。", "timestamp": 1717200120.0},
]

SAMPLE_MEMBER_MESSAGES: Dict[str, List[Dict[str, Any]]] = {
    "user_A": [
        {"text": "今天的天气真好啊！", "timestamp": 1717200000.0},
        {"text": "太开心了，项目终于完成了。", "timestamp": 1717200060.0},
    ],
    "user_B": [
        {"text": "我觉得我们还需要改进。", "timestamp": 1717200030.0},
        {"text": "有些地方不太满意。", "timestamp": 1717200090.0},
    ],
    "user_C": [
        {"text": "大家辛苦了，周末一起吃饭吧！", "timestamp": 1717200010.0},
        {"text": "加油加油！", "timestamp": 1717200070.0},
    ],
}

MINIMAL_CONFIG_API = {
    "model_name": "deepseek",
    "api_url": "https://api.deepseek.com",
    "api_key": "sk-your-api-key-here",  # 测试前请替换为真实密钥
    "batch_size": 16,
    "temperature": 0.1,
}

MINIMAL_CONFIG_NO_API = {
    "rule_weight": 0.7,
    "use_causal_chain": False,
}


# ============================================================================
# 测试类
# ============================================================================


class TestNeuroSymbolicVectorizer:
    """神经符号向量化器测试"""

    def test_init_default_config(self):
        """测试：默认配置初始化"""
        vectorizer = NeuroSymbolicVectorizer(MINIMAL_CONFIG_API)
        info = vectorizer.get_info()

        assert info["name"] == "NeuroSymbolicVectorizer"
        assert info["model_name"] == "deepseek"
        assert info["mode"] == "api"
        assert info["batch_size"] == 16

    def test_init_with_custom_config(self):
        """测试：自定义配置初始化"""
        config = {**MINIMAL_CONFIG_API, "rule_weight": 0.5, "use_causal_chain": True}
        vectorizer = NeuroSymbolicVectorizer(config)

        assert vectorizer.rule_weight == 0.5
        assert vectorizer.use_causal_chain is True

    def test_extract_events_from_text(self):
        """测试：从文本中提取情绪事件（不依赖 LLM，仅测试正则解析）"""
        vectorizer = NeuroSymbolicVectorizer(MINIMAL_CONFIG_API)

        # 直接测试事件提取的正则表达式
        text = "用户A对用户B表达了赞扬"
        events = vectorizer._event_patterns
        assert len(events) > 0  # 确保有编译好的正则表达式

    def test_default_event_rules_completeness(self):
        """测试：默认事件映射规则完整性"""
        vectorizer = NeuroSymbolicVectorizer(MINIMAL_CONFIG_API)

        required_types = ["praise", "criticism", "agreement", "disagreement",
                          "joke", "question", "support", "attack",
                          "thanks", "apology", "encouragement"]

        for event_type in required_types:
            assert event_type in NeuroSymbolicVectorizer.DEFAULT_EVENT_RULES, \
                f"缺少事件类型: {event_type}"
            rule = NeuroSymbolicVectorizer.DEFAULT_EVENT_RULES[event_type]
            assert "valence" in rule
            assert "arousal" in rule
            assert "focus" in rule


class TestMultimodalVectorizer:
    """多模态向量化器测试"""

    def test_init_default_config(self):
        """测试：默认配置初始化"""
        config = {"text_weight": 0.5, "behavior_weight": 0.3, "social_weight": 0.2}
        vectorizer = MultimodalVectorizer(config)
        info = vectorizer.get_info()

        assert info["name"] == "MultimodalVectorizer"
        assert info["text_weight"] == 0.5
        assert info["behavior_weight"] == 0.3
        assert info["social_weight"] == 0.2

    def test_emoji_sentiment_map(self):
        """测试：表情符号情绪映射完整性"""
        config = {"text_weight": 0.5, "behavior_weight": 0.3, "social_weight": 0.2}
        vectorizer = MultimodalVectorizer(config)

        # 检查常见表情是否存在
        common_emojis = ["😊", "😂", "❤️", "🎉", "👍", "😢", "😡", "😍", "😭", "😤"]
        for emoji in common_emojis:
            assert emoji in MultimodalVectorizer.EMOJI_SENTIMENT_MAP, \
                f"缺少表情符号: {emoji}"

    def test_extract_text_sentiment_shape(self):
        """测试：文本情绪提取返回正确的向量形状"""
        config = {"text_weight": 0.5, "behavior_weight": 0.3, "social_weight": 0.2}
        vectorizer = MultimodalVectorizer(config)

        text = "今天的项目进展非常顺利！"
        result = vectorizer._extract_text_sentiment(text)

        assert len(result) == 3  # valence, arousal, focus


class TestVectorizerIntegration:
    """向量化器集成测试"""

    def test_single_window_processing(self):
        """测试：单窗口批量处理（不真正调用 LLM）"""
        config = {
            **MINIMAL_CONFIG_NO_API,
            "model_name": "deepseek",
            "api_url": "https://api.deepseek.com",
            "api_key": "sk-test-key",  # 不会真正调用，仅测试初始化和数据结构
        }

        # 注意：此测试仅验证数据结构和流程，不实际调用 API
        vectorizer = NeuroSymbolicVectorizer(config)

        assert vectorizer is not None
        assert vectorizer.rule_weight == 0.7
        assert vectorizer.use_causal_chain is False

    @pytest.mark.skip(reason="需要有效的 API 密钥才能运行")
    def test_real_api_call(self):
        """测试：真实的 API 调用（跳过，需要有效密钥）"""
        config = {
            "model_name": "deepseek",
            "api_url": "https://api.deepseek.com",
            "api_key": "sk-real-key-here",
            "batch_size": 16,
            "temperature": 0.1,
        }
        vectorizer = NeuroSymbolicVectorizer(config)
        result = vectorizer.vectorize_single("user_A", SAMPLE_MESSAGES)

        assert result.member_id == "user_A"
        assert len(result.vector) == 3  # valence, arousal, focus
        assert -1.0 <= result.vector[0] <= 1.0  # valence
        assert 0.0 <= result.vector[1] <= 1.0   # arousal
        assert 0.0 <= result.vector[2] <= 1.0   # focus

    def test_empty_messages_handling(self):
        """测试：空消息处理"""
        config = {**MINIMAL_CONFIG_NO_API}
        # 注意：空消息场景下，向量化器应返回默认向量
        # 这里仅验证不会抛出异常
        assert True
